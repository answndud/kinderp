# Copy to /opt/kinderp/secrets/backup.env and chmod 600.
BACKUP_DIR=/opt/kinderp-backups
BACKUP_RETENTION_DAYS=14
MYSQL_CONTAINER=kinderp-mysql
REDIS_CONTAINER=kinderp-redis
MYSQL_DATABASE=erp_db
MYSQL_USER=erpadmin
MYSQL_PASSWORD=replace-with-app-db-password
REDIS_PASSWORD=replace-with-redis-password
