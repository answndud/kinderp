# Copy to /opt/kinderp/secrets/backup.env and chmod 600.
BACKUP_DIR=/opt/kinderp-backups
BACKUP_RETENTION_DAYS=14
MYSQL_CONTAINER=kinderp-mysql
REDIS_CONTAINER=kinderp-redis
MYSQL_DATABASE=erp_db
MYSQL_USER=erpadmin
MYSQL_PASSWORD=replace-with-app-db-password
REDIS_PASSWORD=replace-with-redis-password
AGE_RECIPIENT=age1replace-with-recipient
BACKUP_REMOTE_HOST=backup.example.com
BACKUP_REMOTE_USER=kinderp-backup
BACKUP_REMOTE_DIR=/srv/kinderp-backups
BACKUP_SSH_KEY=/opt/kinderp/secrets/backup_ed25519
BACKUP_KNOWN_HOSTS_FILE=/opt/kinderp/secrets/backup_known_hosts
