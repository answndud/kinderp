APP_DOMAIN=erp.example.com
APP_IMAGE=ghcr.io/your-org/kindergarten-erp:image-tag-placeholder
APP_VERSION=commit-sha-placeholder
PROD_ENV_FILE=.env.netcup.example

MYSQL_ROOT_PASSWORD=replace-with-long-random-value
MYSQL_DATABASE=erp_db
MYSQL_USER=erpadmin
MYSQL_PASSWORD=replace-with-long-random-value
FLYWAY_DB_USERNAME=erp_migrator
FLYWAY_DB_PASSWORD=replace-with-a-different-long-random-value
REDIS_PASSWORD=replace-with-long-random-value

NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_FROM=no-reply@erp.example.com
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=replace-with-resend-api-key
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://erp.example.com
SERVER_FORWARD_HEADERS_STRATEGY=framework
JWT_SECRET=replace-with-openssl-rand-base64-64
MANAGEMENT_SERVER_PORT=9091
MANAGEMENT_SERVER_ADDRESS=0.0.0.0

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
NOTIFICATION_INCIDENT_WEBHOOK=
NOTIFICATION_INCIDENT_WEBHOOK_SECRET=replace-with-long-random-secret
NOTIFICATION_PUSH_WEBHOOK=
NOTIFICATION_PUSH_WEBHOOK_SECRET=replace-with-long-random-secret
NOTIFICATION_APP_WEBHOOK=
NOTIFICATION_APP_WEBHOOK_SECRET=replace-with-long-random-secret
